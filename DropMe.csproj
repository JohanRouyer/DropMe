<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DropMe</AssemblyName>
    <RootNamespace>DropMe</RootNamespace>
    <Version>1.2.0</Version>
    <ApplicationIcon>Assets\DropMe.ico</ApplicationIcon>
    <Product>DropMe</Product>
    <Description>Floating drag-and-drop shelf</Description>
    <Authors>JohanRouyer</Authors>
    <Copyright>Copyright (c) 2026 JohanRouyer</Copyright>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JohanRouyer/DropMe</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DropMe.ico" />
  </ItemGroup>

</Project>
