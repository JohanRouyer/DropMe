<Window x:Class="DropMe.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropMe" Width="190" Height="214"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowDrop="True" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#5865F2"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#C0FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="11" Background="#22FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#48FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#40FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="12" CornerRadius="16" Background="#F0202027"
            BorderBrush="#30FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Header: drag to move the shelf -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Left"
                        Margin="8,0,0,0" Click="Close_Click" ToolTip="Fermer"/>
                <Border Width="34" Height="4" CornerRadius="2" Background="#40FFFFFF"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="⤡" FontSize="12"
                            Margin="0,0,4,0" Click="Collapse_Click" ToolTip="Réduire" Visibility="Collapsed"/>
                    <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="⋯" FontSize="13"
                            Click="Menu_Click" ToolTip="Options"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="12,2,12,0">
                <Grid x:Name="EmptyHint">
                    <Rectangle x:Name="DropOutline" RadiusX="12" RadiusY="12" Stroke="#50FFFFFF"
                               StrokeThickness="1.5" StrokeDashArray="4 3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⤓" FontSize="28" Foreground="#90FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Déposez ici" FontSize="12" Foreground="#90FFFFFF"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Collapsed: a fanned stack. Click to expand, drag to take everything. -->
                <Grid x:Name="StackHost" Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                      ToolTip="Cliquez pour tout voir · glissez pour tout déplacer"
                      MouseLeftButtonDown="Stack_MouseLeftButtonDown"
                      MouseMove="Stack_MouseMove"
                      MouseLeftButtonUp="Stack_MouseLeftButtonUp"/>

                <!-- Expanded: one row per file, each can be dragged on its own. -->
                <ScrollViewer x:Name="ListScroller" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                              Margin="-6,0,-6,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="ListHost"/>
                </ScrollViewer>
            </Grid>

            <Border x:Name="Footer" Grid.Row="2" Background="Transparent" Margin="10,0,10,4" CornerRadius="8"
                    MouseLeftButtonDown="Footer_MouseLeftButtonDown" MouseMove="Footer_MouseMove"
                    MouseLeftButtonUp="Footer_MouseLeftButtonUp">
                <TextBlock x:Name="CountText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#D0FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
