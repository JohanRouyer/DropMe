<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders DropMe's real windows with sample files into the PNGs used by the README. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DropMe.Screenshots</AssemblyName>
    <RootNamespace>DropMe.Screenshots</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DropMe.csproj" />
  </ItemGroup>

</Project>
